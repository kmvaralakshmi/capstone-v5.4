# Dynamic air-quality feed; leave blank to use the bundled CPCB snapshot.
# Obtain a personal key from data.gov.in and store it only in your private .env.
DATA_GOV_IN_API_KEY=
# Per-page timeout for data.gov.in. Increase if the feed is slow; failures use the bundled snapshot.
DATA_GOV_IN_TIMEOUT_SECONDS=60

# GDELT request configuration.
GDELT_TIMEOUT_SECONDS=12
GDELT_TIMESPAN=3m

# LLM provider configuration. Use "ollama" for a local model or "none" for no LLM.
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_BASE_URL=http://localhost:11434/v1
LLM_TIMEOUT=120
LLM_DECISION_TIMEOUT=90
LLM_NARRATIVE_TIMEOUT=600
LLM_NARRATIVE_MAX_TOKENS=320
LLM_JUDGE_TIMEOUT=240
LLM_JUDGE_MAX_TOKENS=512

# Routine tool planning defaults to policy; use "on" to restore LLM planning
# on routine steps, or "off" to disable LLM tool planning entirely.
LLM_PLANNER=recover
LLM_MAX_DECISIONS=10
LLM_AGENT_TIME_BUDGET=300
LLM_EVERY=25

# Structured judgements remain available independently of LLM_PLANNER.
LLM_MAX_JUDGEMENTS=300
LLM_JUDGE_TIME_BUDGET=1800
LLM_EXPLAIN_MAX=5

# News screening diagnostics; writes per-candidate results/reasons to the agent log.
NEWS_ESG_DEBUG=0

# For hosted providers, add API credentials to your private .env only.
# OPENAI_API_KEY=
# LLM_API_KEY=
